CORS_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
FRONTEND_URL=http://localhost:3000

# Random string used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# "lax" for local dev (frontend/backend share the "localhost" site).
# Set to "none" in production if the frontend and backend are on different
# domains (e.g. vercel.app + up.railway.app) - required for the session
# cookie to survive cross-site fetch() calls. "none" forces Secure
# (HTTPS-only) automatically, so only set it once you're serving over HTTPS.
SESSION_SAME_SITE=lax

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Add http://localhost:8000/api/auth/google/callback as an
# authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed if request.url_for() would guess the wrong scheme/host (e.g.
# behind a proxy in production) - must exactly match what's registered above.
# GOOGLE_REDIRECT_URI=https://your-api.onrender.com/api/auth/google/callback
